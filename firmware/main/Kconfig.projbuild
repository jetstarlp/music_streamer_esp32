menu "Music Streamer"

    comment "Development settings. Nothing here may be committed with real values."

    config MS_WIFI_SSID
        string "WiFi SSID (temporary, until the provisioning portal exists)"
        default ""
        help
            Network to join at boot. Leave empty to skip WiFi (the firmware then
            only brings up the audio output).

    config MS_WIFI_PASSWORD
        string "WiFi password"
        default ""

    config MS_DEVICE_NAME
        string "Spotify Connect device name"
        default "Music Streamer"
        help
            Name shown in the Spotify app's device list.

    config MS_SPOTIFY_CLIENT_ID
        string "Spotify client ID"
        default ""
        help
            Client ID of your own Spotify developer app
            (https://developer.spotify.com/dashboard). The cspot fork needs it to
            obtain the access token used for resolving the audio CDN URLs.
            Spotify Connect is not started while this is empty.

    config MS_SPOTIFY_CLIENT_SECRET
        string "Spotify client secret"
        default ""
        help
            Client secret belonging to the client ID. Ends up in sdkconfig and in
            the firmware image: never publish either of them. (Planned: move to
            NVS, written once at provisioning time.)

    choice MS_SPOTIFY_BITRATE
        prompt "Spotify audio quality"
        default MS_SPOTIFY_BITRATE_320

        config MS_SPOTIFY_BITRATE_96
            bool "96 kbit/s Ogg Vorbis"
        config MS_SPOTIFY_BITRATE_160
            bool "160 kbit/s Ogg Vorbis"
        config MS_SPOTIFY_BITRATE_320
            bool "320 kbit/s Ogg Vorbis (Premium)"
    endchoice

    config MS_SPOTIFY_BITRATE
        int
        default 96 if MS_SPOTIFY_BITRATE_96
        default 160 if MS_SPOTIFY_BITRATE_160
        default 320

    config MS_HEAP_LOG_PERIOD_S
        int "Heap statistics log period (seconds, 0 = off)"
        default 60
        help
            The serial console command "status" shows the same numbers on
            demand; a frequent log line interrupts typing in the console.
        range 0 3600

    config MS_NET_QEMU_OPENETH
        bool "TEST ONLY: use QEMU's emulated Ethernet instead of WiFi"
        default n
        depends on ETH_USE_OPENETH
        help
            For smoke tests in Espressif's QEMU (see sdkconfig.qemu and
            docs/BUILD.md). Must stay disabled for firmware that runs on the
            real board.

endmenu
